# Any OpenAI-compatible endpoint (NVIDIA Cloud, Moonshot, …)
LLM_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
HOTPATH_AGENT_MODEL=moonshotai/kimi-k3
HOTPATH_CHEAP_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# USD per 1M tokens (verify current prices on the platform)
PRICE_AGENT_IN=3
PRICE_AGENT_OUT=15
PRICE_CHEAP_IN=0.95
PRICE_CHEAP_OUT=4

# Example: Groq (any OpenAI-compatible provider works the same way)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# HOTPATH_AGENT_MODEL=openai/gpt-oss-120b
# HOTPATH_CHEAP_MODEL=openai/gpt-oss-20b
