{
  "name": "hotpath",
  "version": "0.1.0",
  "description": "Record your AI agent once. Replay it faster and cheaper, with AI only where judgment is needed.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/mourad-baazi/hotpath.git"
  },
  "keywords": [
    "ai",
    "agents",
    "mcp",
    "llm",
    "workflow",
    "jit",
    "openclaw"
  ],
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "lint": "eslint . && prettier --check .",
    "hotpath": "tsx packages/cli/src/index.ts",
    "bench": "pnpm --filter demo-tools build && tsx bench/src/index.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^10.11.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@9.15.0"
}
