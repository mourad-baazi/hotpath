---
import Logo from "./Logo.astro";
import { BENCHMARK_URL, DOCS_URL, GITHUB_URL } from "../content";
---

<footer class="border-t border-line py-12">
  <div class="wrap flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
    <div>
      <Logo />
      <p class="mt-3 max-w-xs text-sm text-muted">Agents are the brain. Hotpath is the muscle memory.</p>
    </div>
    <nav aria-label="Footer" class="grid grid-cols-2 gap-x-12 gap-y-2 text-sm sm:grid-cols-3">
      <a href={GITHUB_URL} class="text-muted hover:text-fg">GitHub</a>
      <a href={DOCS_URL} class="text-muted hover:text-fg">Docs</a>
      <a href={BENCHMARK_URL} class="text-muted hover:text-fg">Benchmark</a>
      <a href={`${GITHUB_URL}/blob/main/LICENSE`} class="text-muted hover:text-fg">License (Apache-2.0)</a>
      <a href={`${GITHUB_URL}/blob/main/SECURITY.md`} class="text-muted hover:text-fg">Security</a>
      <a href={`${GITHUB_URL}/issues`} class="text-muted hover:text-fg">Contact</a>
    </nav>
  </div>
  <div class="wrap mt-10 text-xs text-muted">© 2026 Hotpath. Open source under Apache-2.0.</div>
</footer>
