---
import Icon from "./Icon.astro";

interface Props {
  command: string;
  class?: string;
}
const { command, class: className = "" } = Astro.props;
---

<div class={`ticket flex items-stretch overflow-hidden rounded-[10px] border border-line bg-surface ${className}`}>
  <span class="ticket-stub flex shrink-0 items-center px-3 font-mono text-[10px] tracking-[0.16em] text-muted uppercase">
    install
  </span>
  <div class="flex min-w-0 flex-1 items-center gap-2 py-1.5 pr-1.5 pl-3.5">
    <code class="min-w-0 flex-1 overflow-x-auto py-1.5 text-[12px] whitespace-nowrap text-fg [scrollbar-width:none]">
      <span class="text-accent select-none" aria-hidden="true">$ </span>{command}
    </code>
    <button
      type="button"
      class="copy-btn grid size-9 shrink-0 place-items-center rounded-md text-muted transition-colors hover:bg-surface-2 hover:text-fg"
      data-command={command}
      aria-label="Copy command"
    >
      <span class="icon-copy"><Icon name="Copy" size={16} /></span>
      <span class="icon-done hidden text-ok"><Icon name="Check" size={16} /></span>
    </button>
  </div>
  <span class="sr-only" aria-live="polite"></span>
</div>

<style>
  .ticket-stub {
    border-right: 1.5px dashed var(--border);
    background: var(--surface-2);
    writing-mode: horizontal-tb;
  }
</style>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>(".copy-btn")) {
    btn.addEventListener("click", async () => {
      const live = btn.closest(".ticket")?.querySelector("[aria-live]");
      try {
        await navigator.clipboard.writeText(btn.dataset.command ?? "");
        btn.querySelector(".icon-copy")?.classList.add("hidden");
        btn.querySelector(".icon-done")?.classList.remove("hidden");
        if (live) live.textContent = "Copied";
        setTimeout(() => {
          btn.querySelector(".icon-copy")?.classList.remove("hidden");
          btn.querySelector(".icon-done")?.classList.add("hidden");
          if (live) live.textContent = "";
        }, 1600);
      } catch {
        if (live) live.textContent = "Copy failed: select the text instead";
      }
    });
  }
</script>
