---
// A 7x7 pixel grid with one hot path through cold squares: the thermal-scan
// idea of the brand at icon size. Generated, so it stays crisp at any size.
interface Props {
  size?: number;
}
const { size = 40 } = Astro.props;
const hot = [
  [0, 6, "--heat-1"],
  [1, 5, "--heat-2"],
  [2, 4, "--heat-2"],
  [3, 3, "--heat-3"],
  [4, 2, "--heat-3"],
  [5, 1, "--heat-4"],
  [6, 0, "--heat-4"],
] as const;
const cold = [
  [0, 0], [2, 0], [4, 0], [1, 2], [3, 1], [5, 3], [6, 2], [0, 4], [2, 6], [4, 5], [6, 5], [3, 6],
] as const;
---

<svg width={size} height={size} viewBox="0 0 7 7" shape-rendering="crispEdges" aria-hidden="true">
  {cold.map(([x, y]) => <rect x={x} y={y} width="1" height="1" fill="var(--cold)" />)}
  {hot.map(([x, y, c]) => <rect x={x} y={y} width="1" height="1" style={`fill: var(${c})`} />)}
</svg>
