---
// Source of public/og.png (1200×630): screenshot this page at that size
// (see README). Same fonts, tokens and heat field as the site, dark theme.
import "../styles/global.css";
import HeatField from "../components/HeatField.astro";
import Logo from "../components/Logo.astro";
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Hotpath social card</title>
  </head>
  <body>
    <main class="card-og">
      <div class="wash" aria-hidden="true"></div>
      <div class="field"><HeatField /></div>
      <div class="copy">
        <Logo class="logo" />
        <h1 class="display">
          Your agent thinks <em class="italic">once.</em><br />
          Hotpath runs it <em class="heat-text pr-2 italic">forever.</em>
        </h1>
        <p class="sub">Record an AI agent once. Replay it as a workflow,<br />with AI only where judgment is needed.</p>
        <p class="meta">
          <span>open source · MCP</span><span class="sep"></span><span class="url">hotpath.run</span>
        </p>
      </div>
      <div class="bar heat-line" aria-hidden="true"></div>
    </main>
  </body>
</html>

<style>
  :global(body::after) {
    opacity: 0.06;
  }
  .card-og {
    position: relative;
    width: 1200px;
    height: 630px;
    overflow: hidden;
    background: var(--bg);
  }
  .wash {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(520px 420px at 82% 30%, color-mix(in oklab, var(--heat-3) 20%, transparent), transparent 65%),
      radial-gradient(420px 320px at 100% 100%, color-mix(in oklab, var(--heat-1) 22%, transparent), transparent 60%);
  }
  .field {
    position: absolute;
    right: -40px;
    top: 40px;
    width: 700px;
    mask-image: linear-gradient(90deg, transparent 0%, black 16%);
  }
  /* the card is a still: show the final state of every animation */
  .field :global(*) {
    animation-delay: -10s !important;
    animation-iteration-count: 1 !important;
  }
  .field :global(.hot-pulse),
  .field :global(.iso) {
    display: none;
  }
  .copy {
    position: absolute;
    left: 72px;
    top: 64px;
    width: 640px;
  }
  .copy :global(.logo) {
    transform: scale(1.35);
    transform-origin: left center;
  }
  h1 {
    margin-top: 52px;
    font-size: 84px;
    line-height: 0.95;
    color: var(--text);
  }
  .sub {
    margin-top: 26px;
    font-size: 23px;
    line-height: 1.4;
    color: var(--text-muted);
  }
  .meta {
    position: absolute;
    top: 470px;
    display: flex;
    align-items: center;
    gap: 16px;
    font-family: var(--font-mono);
    font-size: 15px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .sep {
    width: 36px;
    height: 1px;
    background: var(--border);
  }
  .url {
    color: var(--accent);
  }
  .bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 6px;
  }
</style>
